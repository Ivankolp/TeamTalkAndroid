<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_description"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_nickname_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/welcome_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/welcome_settings_nickname_hint"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/welcome_gender_female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_gender_female"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/welcome_keep_screen_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_keep_screen"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/welcome_vibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_settings_vibrate"
            android:checked="true" />
    </LinearLayout>
</ScrollView>
